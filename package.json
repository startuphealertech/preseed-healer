{
  "name": "preseedhealer",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @preseedhealer/web",
    "dev:api": "npm run dev -w @preseedhealer/api",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
