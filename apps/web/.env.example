# Public canonical URL of the site (canonical tags, sitemap, OG). Production: https://preseedhealer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Base URL of the Express API, used server-side and for the /api/v1 proxy (needed at build time)
API_URL=http://localhost:4000/api/v1
# Must match REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=change-me-to-a-long-random-string
# Optional: Google Analytics 4 measurement ID (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
