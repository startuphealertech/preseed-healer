NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/preseedhealer

# Browser origins allowed to call the API directly (the web app normally proxies /api/v1)
CORS_ORIGINS=http://localhost:3100
# Reverse-proxy hops in front of the API, for correct client IPs in rate limiting
TRUST_PROXY=1

# Web app URL + shared secret, used to refresh cached pages after admin edits
WEB_URL=http://localhost:3100
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Admin session signing key (at least 32 random chars)
JWT_SECRET=change-me-to-another-long-random-string-32+
SESSION_DAYS=7

# Uploaded images (served at /api/v1/uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Email: leave SMTP_HOST empty in dev to log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PreSeedHealer <no-reply@preseedhealer.com>
NOTIFY_EMAILS=

# First admin account, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@preseedhealer.com
SEED_ADMIN_PASSWORD=change-me-strong-password
